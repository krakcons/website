---
import ContentPage from "../components/ContentPage.astro";
import { loadCompanyPage } from "../utils/company-page";
const redirectStatus = Astro.url.searchParams.has("_preview") ? 302 : 301;
if (Astro.params.slug === "home")
  return Astro.redirect(`/${Astro.url.search}`, redirectStatus);
if (Astro.params.slug === "process")
  return Astro.redirect(`/mission${Astro.url.search}`, redirectStatus);
if (Astro.params.slug === "services")
  return Astro.redirect(`/${Astro.url.search}#services`, redirectStatus);
const pageResult = await loadCompanyPage(Astro.params.slug ?? "", "en");
if (Astro.cache?.enabled) Astro.cache.set(pageResult.cacheHint);
if (!pageResult.data) Astro.response.status = 404;
---

<ContentPage pageResult={pageResult} />
