---
import { getTaxonomyTermsWithCacheHint } from "emdash";
import Insights from "../../../components/Insights.astro";
import NotFound from "../../../components/NotFound.astro";
const result = await getTaxonomyTermsWithCacheHint("tag", { locale: "fr" });
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const term = result.data.find((term) => term.slug === Astro.params.slug);
if (!term) Astro.response.status = 404;
---

{term ? <Insights taxonomy="tag" term={term} /> : <NotFound />}
