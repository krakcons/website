---
import { getSeoMeta, getSiteSettingsWithCacheHint } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import EmailCopy from "./EmailCopy.astro";
import ContactForm from "./ContactForm.astro";
import Ecosystem from "./Ecosystem.astro";
import { loadCompanyPage as loadPage } from "../utils/company-page";
import type { loadCompanyPage } from "../utils/company-page";
interface Props {
  pageResult: Awaited<ReturnType<typeof loadCompanyPage>>;
}
import { getLocale, localePath, messages } from "../utils/i18n";

const locale = getLocale(Astro.currentLocale);
const t = messages[locale];
const link = (path: string) => localePath(path, locale);

const slug = Astro.params.slug ?? "";
const { entry: page, data } = Astro.props.pageResult;
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const settings = settingsResult.data;
const body = page?.data.content ?? [];
const servicesResult =
  slug === "mission" && data
    ? await loadPage("specializations", locale)
    : undefined;
if (Astro.cache?.enabled && servicesResult)
  Astro.cache.set(servicesResult.cacheHint);
const services = servicesResult?.entry;
const approachIndex =
  slug === "mission"
    ? body.findIndex(
        (block) =>
          block._type === "block" &&
          block.style === "h2" &&
          Array.isArray(block.children) &&
          block.children
            .map((child: { text?: string }) => child.text ?? "")
            .join("") === (locale === "fr" ? "Notre démarche" : "How we work"),
      )
    : -1;
const seo = page
  ? getSeoMeta(page, {
      siteTitle: settings?.title ?? "KRAK Consultants",
      siteUrl: process.env.EMDASH_SITE_URL ?? Astro.url.origin,
      path: Astro.url.pathname,
    })
  : undefined;
---

<Base
  title={seo?.title ?? data?.title ?? t.notFound}
  description={seo?.description ?? data?.summary}
  canonical={seo?.canonical}
  content={page ? { collection: "pages", id: page.data.id, slug } : undefined}
>
  {data ? (
    <>
      <section class="page-hero container">
        <nav class="breadcrumb" aria-label={t.breadcrumb}>
          <a href={link("/")}>{t.home}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page" {...page?.edit.title}>
            {data.title}
          </span>
        </nav>
        <h1 {...page?.edit.heading}>{data.heading}</h1>
        <p class="lead" {...page?.edit.summary}>
          {data.summary}
        </p>
        {slug === "mission" && (
          <nav class="project-jump-links" aria-label={t.missionSections}>
            {approachIndex >= 0 && (
              <a href="#approach">
                {t.processLink} <span aria-hidden="true">↓</span>
              </a>
            )}
            <a href="#services">
              {t.servicesLabel} <span aria-hidden="true">↓</span>
            </a>
            <a href="#ecosystem">
              {t.infrastructure.label} <span aria-hidden="true">↓</span>
            </a>
          </nav>
        )}
      </section>
      <section class="container page-body">
        <div class="prose" {...page?.edit.content}>
          {approachIndex >= 0 ? (
            <>
              <PortableText value={body.slice(0, approachIndex)} />
              <section
                class="mission-approach"
                id="approach"
                aria-labelledby="approach-heading"
              >
                <h2 id="approach-heading">
                  {locale === "fr" ? "Notre démarche" : "How we work"}
                </h2>
                <PortableText value={body.slice(approachIndex + 1)} />
              </section>
            </>
          ) : (
            <PortableText value={body} />
          )}
          {slug === "contact" && (
            <div class="contact-details">
              <span class="eyebrow">{t.email}</span>
              <EmailCopy locale={locale} prominent />
            </div>
          )}
        </div>
        {slug === "contact" && <ContactForm locale={locale} />}
      </section>
      {slug === "mission" && (
        <>
          <section
            class="container mission-services"
            id="services"
            aria-labelledby="services-heading"
          >
            <p class="eyebrow">{t.servicesLabel}</p>
            <h2 id="services-heading" {...services?.edit.heading}>
              {services?.data.heading ?? t.servicesHeading}
            </h2>
            {services?.data.summary && (
              <p class="lead" {...services.edit.summary}>
                {services.data.summary}
              </p>
            )}
            {services ? (
              <div class="prose" {...services.edit.content}>
                <PortableText value={services.data.content ?? []} />
              </div>
            ) : (
              <div class="services-grid">
                {t.services.map((service) => (
                  <article class="service-card">
                    <span class="card-number">{service.number}</span>
                    <h3>{service.title}</h3>
                    <p>{service.text}</p>
                  </article>
                ))}
              </div>
            )}
          </section>
          <Ecosystem locale={locale} />
        </>
      )}
    </>
  ) : (
    <section class="container page-hero">
      <p class="eyebrow">404</p>
      <h1>{t.notFoundHeading}</h1>
      <a class="button" href={link("/")}>
        {t.backHome} <span aria-hidden="true">→</span>
      </a>
    </section>
  )}
</Base>

<style>
  .mission-services {
    padding-block: 3rem 4rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 2rem;
  }
  .mission-services > h2 {
    margin-bottom: 1.5rem;
    white-space: pre-line;
  }
  .mission-services > .lead {
    max-width: 760px;
  }
  .mission-approach {
    scroll-margin-top: 2rem;
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .prose .mission-approach > h2:first-child {
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    margin-top: 0;
    margin-bottom: 1.25rem;
  }
  @media (max-width: 760px) {
    .mission-approach {
      margin-top: 2.5rem;
      padding-top: 2rem;
    }
  }
</style>
