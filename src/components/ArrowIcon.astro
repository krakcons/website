---
interface Props {
  direction?: "right" | "up-right";
  class?: string;
}

const { direction = "right", class: className } = Astro.props;
---

<svg
  class:list={["arrow-icon", className]}
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path
    d={
      direction === "up-right"
        ? "M7 17 17 7M7 7h10v10"
        : "M4 12h16m-7-7 7 7-7 7"
    }
  />
</svg>
