---
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type {
  PageServicesSectionBlock,
  PageProjectsSectionBlock,
  PageApproachSectionBlock,
} from "../../../emdash-env";
import ArrowIcon from "../ArrowIcon.astro";
import CardIcon from "../CardIcon.astro";

type Props = BlockComponentProps<
  PageServicesSectionBlock | PageProjectsSectionBlock | PageApproachSectionBlock
> & { appearance?: "connected" | "separate" };
const { value, blockKey, appearance = "connected" } = Astro.props;
const connected = appearance === "connected";
const cards = value.cards ?? [];
const headingId = `cards-heading-${blockKey}`;
---

{cards.length > 0 && (
  <section class="container section-space" aria-labelledby={headingId}>
    <div class="section-heading">
      <div>
        {value.eyebrow && <p class="eyebrow">{value.eyebrow}</p>}
        <h2 id={headingId} class="multiline">
          {value.heading}
        </h2>
      </div>
      {value.link_url && value.link_label && (
        <a class="text-link" href={sanitizeHref(value.link_url)}>
          {value.link_label} <ArrowIcon />
        </a>
      )}
    </div>
    <div class={connected ? "services-grid" : "ecosystem-grid"}>
      {cards.map((card, index) => {
        const Tag = card.url ? "a" : "article";
        return (
          <Tag
            class={connected ? "service-card" : "ecosystem-card"}
            href={card.url ? sanitizeHref(card.url) : undefined}
          >
            {card.icon ? (
              <CardIcon name={card.icon} />
            ) : (
              <span class="card-number">
                {String(index + 1).padStart(2, "0")}
              </span>
            )}
            <h3>{card.title}</h3>
            {card.summary && <p>{card.summary}</p>}
            {card.url && card.link_label && (
              <span class="text-link">
                {card.link_label} {!connected && <ArrowIcon />}
              </span>
            )}
            {card.url && connected && (
              <ArrowIcon class="card-arrow" direction="up-right" />
            )}
          </Tag>
        );
      })}
    </div>
  </section>
)}
