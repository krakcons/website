---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { getLocale, localePath } from "../utils/i18n";
import { insightMessages } from "../utils/insights-i18n";
interface Props {
  taxonomy?: "category" | "tag";
  term?: { slug: string; label: string };
}
const { taxonomy, term } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = insightMessages[locale];
const link = (path: string) => localePath(path, locale);
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
  entries: posts,
  nextCursor,
  cacheHint,
} = await getEmDashCollection("posts", {
  locale,
  limit: 20,
  cursor,
  orderBy: { published_at: "desc" },
  ...(taxonomy && term ? { where: { [taxonomy]: term.slug } } : {}),
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const path = taxonomy && term ? `/${taxonomy}/${term.slug}` : "/posts";
---

<Base title={term ? `${t.title} — ${term.label}` : t.title}>
  <section class="container page-hero">
    <p class="eyebrow">{t.title}</p>
    <h1>{term?.label ?? t.title}</h1>
  </section>
  <section class="container section-space">
    {posts.length ? (
      <div class="project-grid">
        {posts.map((post) => (
          <article class="project-card">
            <a href={link(`/posts/${post.data.slug}`)}>
              {post.data.featured_image && (
                <div {...post.edit.featured_image}>
                  <Image image={post.data.featured_image} />
                </div>
              )}
              <h2 {...post.edit.title}>{post.data.title}</h2>
            </a>
            <p {...post.edit.excerpt}>{post.data.excerpt}</p>
          </article>
        ))}
      </div>
    ) : (
      <p>{t.empty}</p>
    )}
    <nav class="project-jump-links" aria-label={t.pagination}>
      {cursor && <a href={link(path)}>{t.first}</a>}
      {nextCursor && (
        <a href={`${link(path)}?cursor=${encodeURIComponent(nextCursor)}`}>
          {t.next}
        </a>
      )}
    </nav>
  </section>
</Base>
