---
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import type { loadCompanyPage } from "../utils/company-page";
interface Props {
  pageResult: Awaited<ReturnType<typeof loadCompanyPage>>;
}
import { getLocale, localePath, messages } from "../utils/i18n";
import Cards from "./blocks/Cards.astro";
import WorkedWith from "./WorkedWith.astro";
import ArrowIcon from "./ArrowIcon.astro";

const locale = getLocale(Astro.currentLocale);
const t = messages[locale];
const link = (path: string) => localePath(path, locale);
const { entry: home, data } = Astro.props.pageResult;
const showSite = Boolean(data);
---

<Base
  title="KRAK Consultants"
  description={data?.summary}
  content={
    home ? { collection: "pages", id: home.data.id, slug: "home" } : undefined
  }
>
  {showSite ? (
    <>
      <section class="hero container">
        <div class="hero-copy">
          <p class="eyebrow">{t.heroEyebrow}</p>
          <h1 {...home?.edit.heading}>{data?.heading}</h1>
          <p class="lead" {...home?.edit.summary}>
            {data?.summary}
          </p>
          <div class="actions">
            <a class="button" href={link("/contact")}>
              {t.talk} <ArrowIcon direction="up-right" />
            </a>
            <a class="text-link" href={link("/about-us")}>
              {t.meet} <ArrowIcon />
            </a>
          </div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <img
            class="hero-illustration"
            src="/illustrations/technology-for-good.svg"
            alt=""
            width="600"
            height="520"
            fetchpriority="high"
          />
        </div>
      </section>
      <WorkedWith />
      <section class="intro-section">
        <div class="container intro-grid">
          <p class="eyebrow">{t.mission}</p>
          <div>
            <h2 class="multiline">{t.introHeading}</h2>
            <div class="lead" {...home?.edit.content}>
              <PortableText value={home?.data.content ?? []} />
            </div>
            <a class="text-link" href={link("/mission")}>
              {t.missionLink} <ArrowIcon />
            </a>
          </div>
        </div>
      </section>
      <div id="services" {...home?.edit.services_section}>
        {data?.services_section?.map((value, index) => (
          <Cards value={value} index={index} blockKey={value._key} />
        ))}
      </div>
      <div {...home?.edit.approach_section}>
        {data?.approach_section?.map((value, index) => (
          <Cards
            value={value}
            index={index}
            blockKey={value._key}
            appearance="separate"
          />
        ))}
      </div>
      <section class="process-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">{t.workLabel}</p>
              <h2>{t.workHeading}</h2>
            </div>
            <a class="text-link" href={link("/mission")}>
              {t.processLink} <ArrowIcon />
            </a>
          </div>
          <ol class="process-grid">
            {t.steps.map((step, index) => (
              <li>
                <span>0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
      <div {...home?.edit.projects_section}>
        {data?.projects_section?.map((value, index) => (
          <Cards value={value} index={index} blockKey={value._key} />
        ))}
      </div>
    </>
  ) : (
    <section class="container page-hero">
      <p class="eyebrow">KRAK Consultants</p>
      <h1>{t.comingHeading}</h1>
      <p class="lead">{t.comingText}</p>
    </section>
  )}
</Base>
