# Local development defaults to SQLite + local uploads.
# Generate a private key: npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=
EMDASH_SITE_URL=http://localhost:4321

# Docker builds select PostgreSQL + S3 by default.
# For a direct build, export EMDASH_DATABASE=postgres and EMDASH_STORAGE=s3.
# Inject these credentials into the running container, not the build.
DATABASE_URL=postgresql://krak_website:password@postgres:5432/krak_website
S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_BUCKET=krak-website-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave unset to serve private media through EmDash. Do not expose backups.
# S3_PUBLIC_URL=https://media.krakconsultants.com

# Optional runtime SMTP. Leave all SMTP variables unset and select the local
# development console for local testing. If any are set, all five required values
# must be supplied. Production infrastructure injects these for the website.
# SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@wordpress.krakconsultants.net
# SMTP_NAME=Krak Consultants
